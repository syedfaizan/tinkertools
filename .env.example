# Copy to .env.local and fill in what you need. All values are optional;
# sensible defaults for the TinkerTools branding live in src/lib/config.ts.

# Site name shown in header/footer/SEO (default: TinkerTools)
NEXT_PUBLIC_SITE_NAME=TinkerTools

# Canonical URL used by sitemap/robots (default: https://tinkertools.tech)
NEXT_PUBLIC_SITE_URL=https://tinkertools.tech

# Set to "true" once your AdSense account is approved (default: placeholders only)
NEXT_PUBLIC_ADS_ENABLED=false

# AdSense publisher ID, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Search Console verification token (optional — AdSense's publisher check uses
# the client ID above automatically and needs no extra token)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=